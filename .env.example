# TrueSignal - Environment Configuration
# Copy this file to `.env` and fill in API credentials.


# ------------------------------------------------------------------------------
# 1. SERVER & HOSTING
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE & RPC API
# Create a free project at https://supabase.com and run `supabase_schema.sql`
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. FIREBASE AUTHENTICATION (Optional if using Supabase Auth or Single-Tenant)
# Create a Firebase project at https://console.firebase.google.com
# Enable Email/Password & Google Sign-in providers in Firebase Auth.
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-app
FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# 4. META (FACEBOOK) GRAPH API APP CREDENTIALS
# Create a Meta App at https://developers.facebook.com (Type: Business)
# Add "Marketing API" product with permissions: `ads_read`, `business_management`
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# ------------------------------------------------------------------------------
# 5. SHOPIFY CUSTOM APP / PARTNER APP CREDENTIALS
# Create a Custom App in Shopify Admin > Settings > Apps and Sales Channels
# Required Scopes: read_orders, read_products, read_returns, read_discounts, read_customers
# ------------------------------------------------------------------------------
SHOPIFY_CLIENT_ID=your_shopify_api_key_or_client_id
SHOPIFY_CLIENT_SECRET=shpss_your_shopify_secret_here

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE D1 DATABASE
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=951ce610a8f4a49d6227ed151be1fc0b
D1_DATABASE_ID=c7d397e1-86d4-4eeb-83af-911e323f62b5
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
